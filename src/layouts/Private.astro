---
// Layout for password-protected pages. Served only through the /private gate (middleware.ts).
// Images here are plain <img> tags pointing at public/private/…, so they are never copied into public build assets.
import Base from './Base.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props { title: string; client: string; back: { href: string; label: string }; color?: string; intro: string }
const { title, client, back, color = '#18181b', intro } = Astro.props;
---
<Base title={`${title} (protected)`} description={intro} noindex accent={color}>
  <article class="priv" style={`--c:${color}`}>
    <header class="wrap head">
      <a class="back" href={back.href}>
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {back.label}
      </a>
      <p class="client"><span class="lock" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none"><rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.5"/></svg>
      </span>{client}, protected work</p>
      <h1>{title}</h1>
      <p class="intro">{intro}</p>
    </header>
    <div class="wrap body"><slot /></div>
  </article>
  <Lightbox />
</Base>

<style>
  .head { padding-top: clamp(40px, 6vw, 80px); }
  .back { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); text-decoration: none; font-size: var(--step--1); font-weight: 500; }
  .back:hover { color: var(--ink); }
  .back svg { width: 14px; height: 14px; }
  .client { margin-top: 40px; display: flex; align-items: center; gap: 8px; color: var(--mute); font-weight: 500; }
  .lock { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--c); color: #fff; }
  .lock svg { width: 14px; height: 14px; }
  h1 { margin-top: 14px; font-size: var(--step-4); font-weight: 550; letter-spacing: -0.038em; line-height: 1.04; max-width: 18ch; }
  .intro { margin-top: 20px; font-size: var(--step-1); line-height: 1.6; color: var(--ink-2); max-width: 62ch; }
  .body { max-width: 1100px; margin-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(64px, 8vw, 120px); }
  .body :global(> :is(h2, p)) { max-width: 68ch; }
  .body :global(h2) { font-size: var(--step-2); font-weight: 550; letter-spacing: -0.025em; margin-top: clamp(48px, 6vw, 80px); margin-bottom: 14px; }
  .body :global(p) { font-size: var(--step-1); line-height: 1.62; color: var(--ink-2); margin-bottom: 1em; }
</style>
