---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import InitiativeCard from '../../components/InitiativeCard.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  const byOrder = (a: any, b: any) => a.data.order - b.data.order;
  const tops = entries.filter((e) => !e.data.parent).sort(byOrder);
  const kids = (id: string) => entries.filter((e) => e.data.parent === id).sort(byOrder);
  const nextTop = (id: string) => tops[(tops.findIndex((t) => t.id === id) + 1) % tops.length];
  return entries.map((entry) => {
    const parentId = entry.data.parent;
    const parent = parentId ? tops.find((t) => t.id === parentId) : undefined;
    const siblings = parentId ? kids(parentId) : [];
    let next = parentId ? siblings[siblings.findIndex((x) => x.id === entry.id) + 1] : undefined;
    if (!next) next = nextTop(parentId ?? entry.id);
    return { params: { slug: entry.id }, props: { entry, next, parent, siblings, children: kids(entry.id) } };
  });
}
const { entry, next, parent, siblings, children } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const vt = entry.id.replace(/\//g, '-');
const isPart = Boolean(parent);
const isHub = children.length > 0;
// Initiatives show their client's logo; client pages show their own
const logo = d.logo ?? parent?.data.logo;
const host = d.liveUrl ? new URL(d.liveUrl).host.replace(/^www\./, '') : null;
---
<Base title={isPart ? `${d.client} · ${d.name}: ${d.title}` : `${d.client}: ${d.title}`} description={d.summary} accent={d.color}>
  <article style={`--c:${d.color}`}>
    <header class:list={['band', { nocover: !isHub && !d.cover }]} style={`view-transition-name: tile-${vt}`}>
      <div class="wrap band-inner">
        <a class="back" href={isPart ? `/work/${parent!.id}` : '/#work'}>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 8H3m4 4L3 8l4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {isPart ? `All ${d.client} work` : 'All work'}
        </a>
        {isPart ? (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol><li><a href="/#work">Work</a></li><li><a href={`/work/${parent!.id}`}>{d.client}</a></li><li aria-current="page">{d.name}</li></ol>
          </nav>
        ) : (
          <p class="client">{logo ? <span class="plate"><Image src={logo} alt={d.client} height={44} densities={[1, 2]} loading="eager" /></span> : d.client}</p>
        )}
        <h1>{d.title}</h1>
        <p class="summary">{d.summary}</p>
        <dl class="facts">
          <div><dt>Role</dt><dd>{d.role}</dd></div>
          <div><dt>Scope</dt><dd>{d.scope.join(', ')}</dd></div>
          {d.team && <div><dt>Worked with</dt><dd>{d.team}</dd></div>}
          {d.tools.length > 0 && <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
          {host && <div><dt>Live</dt><dd><a href={d.liveUrl} rel="noopener">{host}&nbsp;↗</a></dd></div>}
        </dl>
        {isPart && siblings.length > 1 && (
          <nav class="siblings" aria-label={`Other ${d.client} initiatives`}>
            {siblings.map((sib) => (
              <a href={`/work/${sib.id}`} aria-current={sib.id === entry.id ? 'page' : undefined}>{sib.data.name}</a>
            ))}
          </nav>
        )}
      </div>
    </header>

    <div class="wrap">
      {isHub ? (
        <>
        <section class="hub-cards" aria-label={`${d.client} initiatives`}>
          {children.map((c) => <InitiativeCard entry={c} />)}
        </section>
        {d.anonymized && <p class="note">Client details are anonymized and all data shown is placeholder.</p>}
        </>
      ) : d.cover && (
        <div class="cover" style={`view-transition-name: cover-${vt}`}>
          <Image src={d.cover} alt={d.coverAlt} widths={[640, 1000, 1400, 2000]} sizes="(max-width: 1440px) 92vw, 1300px" loading="eager" fetchpriority="high" />
        </div>
      )}


      <div class="prose">
        <Content />
      </div>
    </div>

    <a class="next wrap" href={`/work/${next.id}`} data-accent={next.data.color} style={`--n:${next.data.color}`}>
      <span class="next-label">{next.data.parent ? `Next ${next.data.client} initiative` : 'Next project'}</span>
      <span class="next-title">{next.data.parent ? next.data.name : next.data.client}</span>
      <span class="next-sum">{next.data.title}</span>
      <span class="next-swatch" aria-hidden="true"></span>
    </a>
  </article>
  <Lightbox />
</Base>

<style>
  .band { background: var(--c); color: #fff; padding-block: clamp(36px, 5vw, 64px) clamp(120px, 14vw, 200px); }
  .band.nocover { padding-bottom: clamp(48px, 6vw, 80px); }
  .band-inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .band-inner > * { min-width: 0; }
  .back {
    justify-self: start; display: inline-flex; align-items: center; gap: 8px; text-decoration: none;
    font-size: var(--step--1); font-weight: 500; padding: 8px 14px 8px 10px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.14); margin-bottom: clamp(20px, 4vw, 48px);
    transition: background var(--t-fast);
  }
  .back:hover { background: rgba(255, 255, 255, 0.24); }
  .back svg { width: 15px; height: 15px; transition: transform var(--t-med) var(--ease-out); }
  .back:hover svg { transform: translateX(-3px); }
  .client { font-weight: 600; font-size: var(--step-1); }
  .plate { display: inline-flex; align-items: center; height: 76px; padding: 0 22px; border-radius: 16px; background: #fff; box-shadow: 0 12px 28px -18px rgba(0, 0, 0, 0.55); }
  .plate :global(img) { height: 40px; width: auto; }
  .hub-cards { margin-top: clamp(-160px, -11vw, -96px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 24px); position: relative; z-index: 1; }
  .hub-cards :global(.init) { box-shadow: 0 0 0 1px var(--line), 0 30px 60px -40px rgba(0, 0, 0, 0.35); }
  @media (max-width: 720px) { .hub-cards { grid-template-columns: 1fr; } .plate { height: 60px; padding: 0 16px; } .plate :global(img) { height: 30px; } }
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: var(--step-0); font-weight: 500; }
  .crumbs li + li::before { content: '/'; margin-right: 8px; opacity: 0.5; }
  .crumbs a { text-decoration: none; opacity: 0.8; }
  .crumbs a:hover { opacity: 1; text-decoration: underline; }
  .crumbs [aria-current] { font-weight: 600; }
  .siblings { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .siblings a {
    font-size: var(--step--1); font-weight: 500; text-decoration: none; padding: 8px 13px; border-radius: 10px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35); transition: background var(--t-fast), color var(--t-fast);
  }
  .siblings a:hover { background: rgba(255, 255, 255, 0.14); }
  .siblings a[aria-current='page'] { background: #fff; color: var(--c); box-shadow: none; }
  h1 { font-size: var(--step-4); font-weight: 550; letter-spacing: -0.038em; max-width: 20ch; }
  .summary { font-size: var(--step-1); line-height: 1.5; max-width: 58ch; color: color-mix(in srgb, #fff 84%, var(--c)); }

  .cover { margin-top: clamp(-160px, -11vw, -96px); border-radius: var(--radius); overflow: hidden; background: var(--soft); box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(0, 0, 0, 0.04); max-height: 78vh; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 0 32px; margin-top: clamp(20px, 2.4vw, 32px); border-top: 1px solid rgba(255, 255, 255, 0.28); max-width: 1180px; }
  .facts div { padding-block: 14px 16px; }
  dt { font-size: var(--step--1); color: color-mix(in srgb, #fff 72%, var(--c)); margin-bottom: 4px; }
  dd { font-size: var(--step-0); }
  @media (max-width: 560px) { .facts { grid-template-columns: 1fr 1fr; gap: 0 20px; } .facts div { padding-block: 10px 12px; } }
  .note { margin-top: 14px; font-size: var(--step--1); color: var(--mute); }
  dd { font-weight: 500; line-height: 1.45; }
  dd a { color: #fff; text-decoration-color: rgba(255, 255, 255, 0.6); text-decoration-thickness: 1.5px; }
  dd a:hover { text-decoration-color: #fff; }

  .prose { max-width: 1100px; margin: clamp(48px, 6vw, 88px) auto 0; }
  .prose :global(> :is(h2, p, ul, ol)) { max-width: 68ch; margin-inline: auto; }
  .prose :global(h2) { font-size: var(--step-3); font-weight: 550; letter-spacing: -0.033em; margin-top: clamp(56px, 7vw, 96px); margin-bottom: 18px; }
  .prose :global(h2::before) { content: ''; display: block; width: 28px; height: 4px; border-radius: 2px; background: var(--c); margin-bottom: 18px; }
  .prose :global(p) { font-size: var(--step-1); line-height: 1.62; color: var(--ink-2); margin-bottom: 1.1em; }
  .prose :global(p strong) { color: var(--ink); font-weight: 600; }
  .prose :global(> figure) { margin-inline: auto; }

  .next {
    display: grid; gap: 8px; margin-top: clamp(96px, 11vw, 160px); text-decoration: none; position: relative;
    padding-block: clamp(40px, 6vw, 72px);
    border-top: 1px solid var(--line);
  }
  .next-label { font-size: var(--step--1); color: var(--mute); }
  .next-title { font-size: var(--step-4); font-weight: 550; letter-spacing: -0.04em; line-height: 1; transition: color var(--t-med) var(--ease-out); }
  .next-sum { color: var(--ink-2); font-size: var(--step-1); max-width: 50ch; }
  .next-swatch {
    position: absolute; right: var(--gutter); top: 50%; width: clamp(64px, 9vw, 120px); aspect-ratio: 1;
    border-radius: 22px; background: var(--n); transform: translateY(-50%) rotate(-8deg) scale(0.9);
    transition: transform var(--t-slow) var(--ease-out), border-radius var(--t-slow) var(--ease-out);
  }
  .next:hover .next-title, .next:focus-visible .next-title { color: var(--n); }
  .next:hover .next-swatch, .next:focus-visible .next-swatch { transform: translateY(-50%) rotate(0) scale(1); border-radius: 50%; }
  @media (max-width: 640px) { .next-swatch { display: none; } }
</style>
