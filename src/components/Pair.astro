---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { a: ImageMetadata; aAlt: string; b: ImageMetadata; bAlt: string; caption?: string; narrow?: boolean }
const { a, aAlt, b, bAlt, caption, narrow = false } = Astro.props;
const items = [ { src: a, alt: aAlt }, { src: b, alt: bAlt } ];
---
<figure class:list={['pair', 'reveal', { narrow }]}>
  <div class="row">
    {items.map((it) => (
      <button type="button" class="zoom" data-zoom={it.src.src} data-zoom-w={it.src.width} data-zoom-h={it.src.height} aria-label={`Enlarge image: ${it.alt}`}>
        <Image src={it.src} alt={it.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 94vw, 540px" loading="lazy" />
      </button>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .pair { margin-block: clamp(32px, 5vw, 56px); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(12px, 2vw, 24px); align-items: start; }
  .narrow .row { max-width: 640px; }
  .zoom { display: block; padding: 0; border: 0; background: var(--soft); border-radius: 14px; overflow: hidden; cursor: zoom-in; box-shadow: 0 0 0 1px var(--line); max-height: 640px; }
  .zoom :global(img) { width: 100%; object-fit: cover; object-position: top; transition: transform var(--t-slow) var(--ease-out); }
  .zoom:hover :global(img) { transform: scale(1.015); }
  figcaption { margin-top: 12px; font-size: var(--step--1); color: var(--mute); }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } .narrow .row { grid-template-columns: 1fr 1fr; } }
</style>
