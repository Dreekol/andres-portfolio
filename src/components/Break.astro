---
// A wide visual pause between sections: a crop of brand or product imagery, no zoom.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; position?: string; caption?: string; ratio?: string }
const { src, alt, position = 'center', caption, ratio = '21 / 9' } = Astro.props;
---
<figure class="break reveal">
  <div class="frame" style={`aspect-ratio: ${ratio}`}>
    <Image src={src} alt={alt} widths={[640, 1000, 1400]} sizes="(max-width: 900px) 94vw, 1100px" loading="lazy" style={`object-position: ${position}`} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .break { margin-block: clamp(48px, 8vw, 96px); }
  .frame { border-radius: 16px; overflow: hidden; background: var(--soft); box-shadow: 0 0 0 1px var(--line); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  figcaption { margin-top: 12px; font-size: var(--step--1); color: var(--mute); }
</style>
