---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'work'> }
const { entry } = Astro.props;
const d = entry.data;
---
<a class="g reveal" href={`/work/${entry.id}`} data-accent={d.color} data-domains={d.domains.join('|')} data-types={d.workTypes.join('|')} style={`--c:${d.color}; view-transition-name: card-${entry.id.replace(/\//g, '-')}`}>
  <div class="frame" style={`view-transition-name: cover-${entry.id.replace(/\//g, '-')}`}>
    <Image src={d.cover} alt={d.coverAlt} widths={[400, 700, 1000]} sizes="(max-width: 760px) 92vw, 30vw" loading="lazy" style={`object-position:${d.coverPosition}`} />
  </div>
  <div class="t">
    <h3><span class="dot" aria-hidden="true"></span>{d.client}</h3>
    <p>{d.title}</p>
  </div>
</a>

<style>
  .g { display: grid; gap: 14px; text-decoration: none; color: inherit; transition: opacity var(--t-med) var(--ease-out), filter var(--t-med); }
  .frame { aspect-ratio: 4 / 3; background: var(--soft); border-radius: 18px; overflow: hidden; position: relative; }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.001); transition: transform var(--t-slow) var(--ease-out); }
  .g:hover .frame :global(img), .g:focus-visible .frame :global(img) { transform: scale(1.04); }
  h3 { font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; display: flex; align-items: center; gap: 9px; }
  .dot { width: 10px; height: 10px; border-radius: 3px; background: var(--c); transition: transform var(--t-med) var(--ease-out), border-radius var(--t-med); }
  .g:hover .dot, .g:focus-visible .dot { transform: rotate(45deg) scale(1.15); border-radius: 2px; }
  p { margin-top: 4px; color: var(--mute); font-size: var(--step--1); line-height: 1.45; max-width: 40ch; }
</style>
