---
// The filterable list of work, shared by the homepage and /work so both behave identically.
import { getCollection } from 'astro:content';
import ProjectTile from './ProjectTile.astro';
import WorkIndex from './WorkIndex.astro';
import TypeMarker from './TypeMarker.astro';
import Filter from './Filter.astro';
import { domains, workTypes } from '../data/site';

const entries = await getCollection('work');
const all = entries.filter((e) => !e.data.parent).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((e) => e.data.featured);
const rest = all.filter((e) => !e.data.featured);
const childCount = (id: string) => entries.filter((e) => e.data.parent === id).length;

// Industry counts: client-level projects. Type counts: every initiative or standalone project that does that work.
const domainCounts: Record<string, number> = {};
all.forEach((e) => e.data.domains.forEach((d) => (domainCounts[d] = (domainCounts[d] ?? 0) + 1)));
const typeCounts: Record<string, number> = {};
entries.filter((e) => e.data.parent || !childCount(e.id)).forEach((e) => e.data.workTypes.forEach((t) => (typeCounts[t] = (typeCounts[t] ?? 0) + 1)));
---
<div class="wrap filters" id="work">
  <div class="switch" role="group" aria-label="Filter by">
    <button type="button" data-show="industry" aria-pressed="true">Industry</button>
    <button type="button" data-show="type" aria-pressed="false">Type of work</button>
    <span class="thumb" aria-hidden="true"></span>
  </div>
  <Filter id="f-industry" items={domains} attr="domains" counts={domainCounts} target=".tiles" label="Show projects by industry" />
  <Filter id="f-type" items={workTypes} attr="types" counts={typeCounts} target=".tiles" label="Show projects by type of work" hidden />
</div>

<section class="wrap block" aria-labelledby="cs-h">
  <h2 id="cs-h" class="label">Featured case studies</h2>
  <div class="tiles featured">
    {featured.map((e, i) => <ProjectTile entry={e} size={i % 3 === 0 ? 'wide' : 'narrow'} eager={i < 2} initiatives={childCount(e.id)} />)}
  </div>
</section>

<section class="wrap block more" aria-labelledby="sw-h">
  <div class="sw-head">
    <h2 id="sw-h" class="label" tabindex="-1">Other selected work</h2>
    <ul class="key" aria-label="Type of work key">
      {workTypes.filter((t) => rest.some((e) => e.data.workTypes.includes(t))).map((t) => <li><TypeMarker type={t} />{t}</li>)}
    </ul>
  </div>
  <p class="now" hidden>
    <span class="now-text"></span>
    <button type="button" class="now-clear">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4.5 4.5 7 7m0-7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      Show all
    </button>
  </p>
  <WorkIndex entries={rest} />
</section>

<style>
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; margin-bottom: clamp(36px, 4vw, 56px); scroll-margin-top: 96px; }

  /* Segmented switch with a sliding thumb */
  .switch { position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 12px; background: var(--soft); isolation: isolate; }
  .switch button { position: relative; z-index: 1; border: 0; background: none; padding: 8px 14px; border-radius: 9px; font-size: var(--step--1); font-weight: 500; color: var(--mute); white-space: nowrap; transition: color var(--t-med) var(--ease-out); }
  .switch button[aria-pressed='true'] { color: var(--ink); }
  .thumb { position: absolute; z-index: 0; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 9px; background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08), 0 4px 12px -4px rgba(0, 0, 0, 0.12); transition: transform var(--t-med) var(--ease-out); }
  .switch[data-active='type'] .thumb { transform: translateX(100%); }
  .filters :global(.filter:not([hidden])) { animation: chips-in var(--t-med) var(--ease-out); }
  @keyframes chips-in { from { opacity: 0; transform: translateX(-8px); } }

  .label { font-size: var(--step-2); font-weight: 550; letter-spacing: -0.025em; margin-bottom: 20px; }
  .featured { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(14px, 1.7vw, 24px); }
  .featured[data-count='1'] :global(.tile) { grid-column: 1 / -1; }
  /* An odd card out on the last row spans it, so the grid never ends on a hole (unfiltered view only) */
  .featured:not([data-filter]) :global(.tile:last-child:nth-child(odd)) { grid-column: 1 / -1; }
  @media (min-width: 961px) {
    /* Wide card: identity and title on the left, the initiative index on the right */
    .featured:not([data-filter]) :global(.tile:last-child:nth-child(odd)) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: clamp(32px, 5vw, 80px); }
    .featured:not([data-filter]) :global(.tile:last-child:nth-child(odd) > .index) { grid-column: 2; grid-row: 1 / span 3; align-self: end; }
  }
  .more { margin-top: clamp(80px, 9vw, 128px); }
  .sw-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 24px; margin-bottom: 18px; }
  .sw-head .label { margin-bottom: 0; }
  .key { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: var(--step--1); color: var(--ink-2); }
  .key li { display: inline-flex; align-items: center; gap: 7px; }
  /* Shown above the list while a filter is on, so the state is visible without scrolling back to the chips */
  .now { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin: 0 0 16px; padding: 10px 10px 10px 16px; border-radius: 12px; background: var(--soft); font-size: var(--step--1); color: var(--ink-2); }
  .now[hidden] { display: none; }
  .now :global(b) { color: var(--ink); font-weight: 600; }
  .now-clear { display: inline-flex; align-items: center; gap: 6px; margin-left: auto; border: 0; background: none; padding: 6px 8px; border-radius: 8px; font: inherit; font-weight: 500; color: var(--ink); text-decoration: underline; text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
  .now-clear:hover { background: #fff; }
  .now-clear:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .now-clear svg { width: 14px; height: 14px; }
  @media (max-width: 960px) { .featured { grid-template-columns: 1fr; } }
</style>

<script>
  // "Showing N <filter> projects" note above Other selected work
  const now = document.querySelector<HTMLElement>('.now');
  const list = document.querySelector<HTMLElement>('.more .tiles');
  let activeGroup: string | null = null;
  document.addEventListener('work:filter', (e) => {
    const { active, group } = (e as CustomEvent<{ active: string | null; group: string }>).detail;
    if (!now || !list) return;
    if (!active) { if (activeGroup === group || !activeGroup) { now.hidden = true; activeGroup = null; } return; }
    activeGroup = group;
    const text = now.querySelector('.now-text')!;
    text.replaceChildren('Filtered by ', Object.assign(document.createElement('b'), { textContent: active }));
    now.hidden = false;
  });
  now?.querySelector('.now-clear')?.addEventListener('click', () => {
    if (activeGroup) document.getElementById(activeGroup)?.dispatchEvent(new Event('filter:clear'));
    // The button hides itself, so hand keyboard focus to the list heading
    document.getElementById('sw-h')?.focus({ preventScroll: true });
  });

  const sw = document.querySelector<HTMLElement>('.switch');
  if (sw) {
    const groups: Record<string, HTMLElement | null> = { industry: document.getElementById('f-industry'), type: document.getElementById('f-type') };
    sw.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const show = btn.dataset.show!;
        sw.dataset.active = show;
        sw.querySelectorAll('[data-show]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        Object.entries(groups).forEach(([k, el]) => {
          if (!el) return;
          el.dispatchEvent(new Event('filter:reset'));
          el.hidden = k !== show;
        });
      });
    });
  }
</script>
