---
// Selected work as a scannable index: client · what I did · type of work · industry.
// A preview of the work appears beside the row on hover or keyboard focus.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TypeMarker from './TypeMarker.astro';
interface Props { entries: CollectionEntry<'work'>[] }
const { entries } = Astro.props;
---
<div class="cols" aria-hidden="true">
  <span>Client</span><span>What I did</span><span>Type of work</span><span>Industry</span><span></span>
</div>
<ol class="tiles list">
  {entries.map((e) => {
    const d = e.data;
    return (
      <li data-domains={d.domains.join('|')} data-types={d.workTypes.join('|')} data-accent={d.color} style={`view-transition-name: row-${e.id.replace(/\//g, '-')}`}>
        <a class="row reveal" href={`/${e.id}`}>
          <span class="client">{d.client}</span>
          <span class="what">{d.title}</span>
          <span class="types">
            {d.workTypes.map((t) => <span class="type"><TypeMarker type={t} />{t}</span>)}
          </span>
          <span class="ind">{d.domains.join(', ') || '—'}</span>
          <span class="go" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          {d.cover && (
            <span class="preview" aria-hidden="true">
              <Image src={d.cover} alt="" widths={[360, 640]} sizes="320px" loading="lazy" style={`object-position:${d.coverPosition}`} />
            </span>
          )}
        </a>
      </li>
    );
  })}
</ol>

<style>
  .cols, .row { display: grid; grid-template-columns: minmax(180px, 1.1fr) minmax(0, 2fr) minmax(0, 1.4fr) minmax(110px, 0.8fr) 36px; gap: 24px; align-items: center; }
  .cols { font-size: var(--step--1); color: var(--mute); padding-bottom: 10px; }
  .list { list-style: none; padding: 0; border-top: 1.5px solid var(--ink); }
  li { border-bottom: 1px solid var(--line); }
  .row {
    position: relative; padding: 20px 8px; text-decoration: none; color: inherit;
    transition: background var(--t-med) var(--ease-out), padding var(--t-med) var(--ease-out);
  }
  .client { font-weight: 600; font-size: var(--step-1); letter-spacing: -0.015em; line-height: 1.25; }
  .what { color: var(--ink-2); line-height: 1.45; }
  .types { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: var(--step--1); color: var(--ink-2); }
  .type { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  .ind { font-size: var(--step--1); color: var(--mute); }
  .go { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--soft); transition: background var(--t-med) var(--ease-out), color var(--t-med); }
  .go svg { width: 14px; height: 14px; transition: transform var(--t-med) var(--ease-out); }

  .preview {
    position: absolute; right: 64px; top: 50%; z-index: 5; width: 300px; aspect-ratio: 4 / 3;
    border-radius: 12px; overflow: hidden; background: var(--soft); pointer-events: none;
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(0, 0, 0, 0.06);
    opacity: 0; transform: translateY(-50%) translateX(16px) rotate(-3deg) scale(0.94);
    transition: opacity var(--t-fast) var(--ease-out), transform var(--t-med) var(--ease-out);
  }
  .preview :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .row:hover, .row:focus-visible { background: var(--soft); padding-inline: 16px 12px; }
  .row:hover .go, .row:focus-visible .go { background: var(--ink); color: #fff; }
  .row:hover .go svg, .row:focus-visible .go svg { transform: translateX(2px); }
  .row:hover .preview, .row:focus-visible .preview { opacity: 1; transform: translateY(-50%) rotate(-2deg) scale(1); }

  @media (max-width: 960px) {
    .cols { display: none; }
    .row { grid-template-columns: minmax(0, 1fr) 34px; gap: 6px 16px; padding: 18px 4px; }
    .client, .what, .types, .ind { grid-column: 1; }
    .go { grid-column: 2; grid-row: 1 / span 4; }
    .types { margin-top: 6px; }
    .preview { display: none; }
  }
</style>
