---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cta">
      <h2>Have a complex product that needs to feel simple? <span>Let’s talk.</span></h2>
      <div class="actions">
        <a class="pill" href={`mailto:${site.email}`}>Email me
          <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <button class="pill pill--ghost copy" type="button" data-copy={site.email}>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 3.2A1.5 1.5 0 0 0 9 2H4a2 2 0 0 0-2 2v5a1.5 1.5 0 0 0 1.2 1.47" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span data-label>Copy email</span>
        </button>
        <a class="pill pill--ghost" href={site.linkedin} rel="me noopener">LinkedIn</a>
        <a class="pill pill--ghost" href="/resume">Resume</a>
      </div>
    </div>
    <div class="meta">
      <span>© {year} {site.name} · {site.location}</span>
      <span>Designed and built by me, with Astro and Claude Code. <button type="button" class="grid-btn" data-toggle-grid>See the grid <kbd>G</kbd></button></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: clamp(96px, 12vw, 180px); border-top: 1px solid var(--line); }
  .cta { padding-block: clamp(56px, 8vw, 104px) clamp(40px, 6vw, 72px); display: grid; gap: 32px; }
  h2 { font-size: var(--step-4); font-weight: 550; letter-spacing: -0.035em; max-width: 18ch; }
  h2 span { color: var(--accent); transition: color var(--t-med) var(--ease-out); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .copy[data-state='copied'] { box-shadow: inset 0 0 0 1.5px #15803d; color: #15803d; }
  .meta {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    padding-block: 24px 32px; border-top: 1px solid var(--line);
    font-size: var(--step--1); color: var(--mute);
  }
  .grid-btn { background: none; border: 0; padding: 0; color: var(--ink); text-decoration: underline; text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
  kbd { font: inherit; font-size: 0.78em; padding: 1px 6px; border-radius: 5px; box-shadow: inset 0 0 0 1px var(--line); margin-left: 4px; text-decoration: none; display: inline-block; }
</style>
