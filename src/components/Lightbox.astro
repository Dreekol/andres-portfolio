<dialog class="lightbox" aria-label="Enlarged image">
  <button type="button" class="close" aria-label="Close enlarged image">
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  </button>
  <div class="scroller"><img alt="" /></div>
</dialog>

<style>
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; padding: 0; border: 0;
    background: rgba(250, 250, 250, 0.96); color: var(--ink);
  }
  .lightbox::backdrop { background: rgba(14, 14, 16, 0.4); backdrop-filter: blur(4px); }
  .lightbox[open] { animation: lb-in var(--t-med) var(--ease-out); }
  .lightbox[open] img { animation: lb-img var(--t-slow) var(--ease-out); }
  @keyframes lb-in { from { opacity: 0; } }
  @keyframes lb-img { from { opacity: 0; transform: translateY(18px) scale(0.98); } }
  .scroller { height: 100%; overflow: auto; display: grid; place-items: start center; padding: clamp(56px, 7vw, 88px) clamp(12px, 4vw, 48px); }
  .scroller img { width: auto; max-width: min(100%, 1600px); height: auto; border-radius: 12px; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.35); cursor: zoom-out; }
  .close {
    position: fixed; top: 16px; right: 16px; z-index: 2; width: 44px; height: 44px; border-radius: 50%;
    border: 0; background: var(--ink); color: #fff; display: grid; place-items: center;
  }
  .close svg { width: 16px; height: 16px; }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dlg) {
    const img = dlg.querySelector('img')!;
    let opener: HTMLElement | null = null;
    document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        opener = btn;
        const inner = btn.querySelector('img');
        img.src = btn.dataset.zoom!;
        img.alt = inner?.alt ?? '';
        img.width = Number(btn.dataset.zoomW);
        img.height = Number(btn.dataset.zoomH);
        dlg.showModal();
        dlg.querySelector<HTMLButtonElement>('.close')!.focus();
      });
    });
    const close = () => dlg.close();
    dlg.querySelector('.close')!.addEventListener('click', close);
    img.addEventListener('click', close);
    dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('scroller')) close(); });
    dlg.addEventListener('close', () => opener?.focus());
  }
</script>
