---
import TypeMarker from './TypeMarker.astro';
interface Props {
  items: readonly string[];
  /** Which data attribute on project elements to match: data-domains or data-types */
  attr: 'domains' | 'types';
  counts: Record<string, number>;
  target: string;
  label: string;
  hidden?: boolean;
  id?: string;
}
const { items, attr, counts, target, label, hidden = false, id } = Astro.props;
---
<div class="filter" role="group" aria-label={label} data-filter-for={target} data-attr={attr} hidden={hidden} id={id}>
  {items.filter((d) => counts[d]).map((d) => (
    <button type="button" class="chip" data-value={d} aria-pressed="false">
      {attr === 'types' && <TypeMarker type={d} />}{d}<span class="n" aria-label={`${counts[d]} projects`}>{counts[d]}</span>
    </button>
  ))}
  <button type="button" class="clear" hidden>
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4.5 4.5 7 7m0-7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    Show all
  </button>
  <span class="status visually-hidden" aria-live="polite"></span>
</div>

<style>
  .filter { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .filter[hidden] { display: none; }
  .n {
    min-width: 24px; height: 24px; padding: 0 7px; border-radius: 999px; display: inline-grid; place-items: center;
    background: #fff; color: var(--mute); font-size: 11.5px; font-weight: 600; font-variant-numeric: tabular-nums;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .chip[aria-pressed='true'] .n { background: rgba(255, 255, 255, 0.16); color: #fff; }
  .chip :global(.tm) { margin-right: -2px; }
  .clear {
    display: inline-flex; align-items: center; gap: 6px; border: 0; background: none; padding: 9px 6px;
    font-size: var(--step--1); font-weight: 500; color: var(--mute);
    text-decoration: underline; text-underline-offset: 0.22em; text-decoration-thickness: 1px;
  }
  .clear[hidden] { display: none; }
  .clear:hover { color: var(--ink); }
  .clear svg { width: 14px; height: 14px; }
</style>

<script>
  // Selecting a chip shows only the matching projects; selecting it again (or "Show all") brings everything back.
  // The reflow is animated with a same-document view transition where supported.
  document.querySelectorAll<HTMLElement>('[data-filter-for]').forEach((group) => {
    const attr = group.dataset.attr!;
    const targets = document.querySelectorAll<HTMLElement>(group.dataset.filterFor!);
    const chips = group.querySelectorAll<HTMLButtonElement>('[data-value]');
    const clear = group.querySelector<HTMLButtonElement>('.clear')!;
    const status = group.querySelector('.status')!;
    let active: string | null = null;

    const render = () => {
      let total = 0;
      targets.forEach((t) => {
        const items = t.querySelectorAll<HTMLElement>(`[data-${attr}]`);
        let shown = 0;
        items.forEach((el) => {
          const match = !active || (el.dataset[attr] ?? '').split('|').includes(active);
          el.toggleAttribute('data-out', !match);
          if (match) shown++;
        });
        // A hub tile lists its initiatives: show only the ones that match, and keep the count honest
        t.querySelectorAll<HTMLElement>('.index').forEach((index) => {
          const count = index.querySelector('.count');
          if (count) {
            const n = index.querySelectorAll('li:not([data-out])').length;
            count.textContent = `${n} initiative${n === 1 ? '' : 's'}`;
          }
        });
        total += shown;
        if (active) t.dataset.filter = active; else t.removeAttribute('data-filter');
        t.dataset.count = String(shown);
        // Hide a whole section when nothing in it matches
        const section = t.closest('section');
        if (section) section.toggleAttribute('data-empty', shown === 0);
      });
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.value === active)));
      clear.hidden = !active;
      status.textContent = active ? `Showing ${total} ${active} project${total === 1 ? '' : 's'}` : 'Showing all projects';
      // Let other parts of the page (like the Other selected work note) reflect the active filter
      document.dispatchEvent(new CustomEvent('work:filter', { detail: { active, group: group.id } }));
    };

    const set = (value: string | null) => {
      active = value;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (doc.startViewTransition && !reduce) {
        document.documentElement.classList.add('filtering');
        const vt = doc.startViewTransition(render) as { finished: Promise<void> };
        vt.finished.finally(() => document.documentElement.classList.remove('filtering'));
      } else render();
    };

    chips.forEach((chip) => chip.addEventListener('click', () => set(active === chip.dataset.value ? null : chip.dataset.value!)));
    clear.addEventListener('click', () => { set(null); chips[0]?.focus(); });
    group.addEventListener('filter:reset', () => { active = null; render(); });
    // Clear from elsewhere on the page without moving focus back up to the chips
    group.addEventListener('filter:clear', () => set(null));
  });
</script>
