---
// Figure for protected pages: a plain <img> from public/private (gated by middleware), with the same zoom behavior as Figure.
interface Props { src: string; width: number; height: number; alt: string; caption?: string }
const { src, width, height, alt, caption } = Astro.props;
---
<figure class="fig">
  <button type="button" class="zoom" data-zoom={src} data-zoom-w={width} data-zoom-h={height} aria-label={`Enlarge image: ${alt}`}>
    <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin-block: clamp(28px, 4vw, 48px); }
  .zoom { display: block; width: 100%; padding: 0; border: 0; background: var(--soft); border-radius: 16px; overflow: hidden; cursor: zoom-in; box-shadow: 0 0 0 1px var(--line); }
  .zoom img { width: 100%; height: auto; display: block; }
  .zoom:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  figcaption { margin-top: 12px; color: var(--mute); font-size: var(--step--1); }
</style>
