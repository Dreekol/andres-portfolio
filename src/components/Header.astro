---
import { site } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="/" aria-label={`${site.name}, home`}>
      <span class="logo" aria-hidden="true">Andr<span class="e">e<span class="acute"></span></span>s Velasco</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a class="pill" href={`mailto:${site.email}`}>Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-med);
    view-transition-name: site-header;
  }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 76px; }
  .mark { text-decoration: none; font-weight: 600; font-size: 1.02rem; letter-spacing: -0.015em; }
  .logo { white-space: nowrap; }
  /* The personal mark: a drawn acute accent over the e that takes the active project's colour */
  .e { position: relative; display: inline-block; }
  .acute {
    position: absolute; left: 50%; top: -0.06em; width: 0.17em; height: 0.36em;
    background: var(--accent); border-radius: 0.08em;
    transform: translateX(-30%) rotate(38deg); transform-origin: bottom center;
    transition: background var(--t-med) var(--ease-out), transform var(--t-med) var(--ease-out);
  }
  .mark:hover .acute { transform: translateX(-30%) rotate(48deg) scaleY(1.12); }

  nav { margin-left: auto; display: flex; align-items: center; gap: clamp(12px, 2.4vw, 32px); }
  ul { list-style: none; padding: 0; display: flex; gap: clamp(14px, 2.4vw, 32px); }
  nav ul a {
    text-decoration: none; color: var(--mute); font-size: var(--step--1); font-weight: 500;
    position: relative; padding-block: 6px; transition: color var(--t-fast);
  }
  nav ul a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: var(--ink);
    transform: scaleX(0); transform-origin: right; transition: transform var(--t-med) var(--ease-out);
  }
  nav ul a:hover, nav ul a[aria-current='page'] { color: var(--ink); }
  nav ul a:hover::after, nav ul a[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }

  @media (max-width: 640px) {
    .bar { min-height: 64px; gap: 12px; }
    ul { gap: 14px; }
    .pill { display: none; }
    .logo { font-size: 0.95rem; }
  }
  @media (max-width: 380px) {
    .logo .last { display: none; }
  }
</style>
