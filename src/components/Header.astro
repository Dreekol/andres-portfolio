---
import { site } from '../data/site';
const path = Astro.url.pathname;
// The name is split into letters so it can flip like a split-flap (Solari) board
const nameChars = [...'Andres Velasco'];
const links = [
  { href: '/', label: 'Work', match: (p: string) => p === '/' || p.startsWith('/work') },
  { href: '/about', label: 'About', match: (p: string) => p.startsWith('/about') },
  { href: '/resume', label: 'Resume', match: (p: string) => p.startsWith('/resume') },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="/" aria-label={`${site.name}, home`}>
      <span class="logo" aria-hidden="true">
        {nameChars.map((c, i) =>
          c === ' ' ? <span class="gap"> </span> : (
            <span class="flap"><span class="ch" data-final={c}>{c}</span>{i === 4 && <span class="acute"></span>}</span>
          )
        )}
      </span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a class="pill contact" href={`mailto:${site.email}`} aria-label="Get in touch by email">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.75" y="3.25" width="12.5" height="9.5" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="m2.5 4.5 5.5 4 5.5-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="label">Get in touch</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-med);
    view-transition-name: site-header;
  }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 76px; }
  .mark { text-decoration: none; font-weight: 650; font-size: 1.28rem; letter-spacing: -0.025em; line-height: 1; }
  .logo { white-space: nowrap; display: inline-flex; align-items: baseline; }
  .gap { display: inline-block; width: 0.26em; }

  /* Split-flap letters */
  .flap { position: relative; display: inline-block; text-align: center; perspective: 220px; }
  .ch { display: inline-block; transform-origin: 50% 54%; backface-visibility: hidden; }
  .ch.tick { animation: flip 90ms linear; }
  @keyframes flip { from { transform: rotateX(-88deg); opacity: 0.35; } to { transform: rotateX(0); opacity: 1; } }
  /* the hinge line of a flap, only visible while the board is turning */
  .flap::after {
    content: ''; position: absolute; left: -1px; right: -1px; top: 54%; height: 1px;
    background: currentColor; opacity: 0; transition: opacity 200ms;
  }
  .rolling .flap::after { opacity: 0.18; }

  /* The personal mark: a drawn acute accent over the e that takes the active project's colour */
  .acute {
    position: absolute; left: 52%; top: -0.2em; width: 0.16em; height: 0.36em;
    background: var(--accent); border-radius: 0.08em;
    transform: translateX(-30%) rotate(38deg); transform-origin: bottom center;
    transition: background var(--t-med) var(--ease-out), transform var(--t-med) var(--ease-out), opacity 160ms;
  }
  .rolling .acute { opacity: 0; transform: translateX(-30%) translateY(-0.5em) rotate(38deg); transition: none; }
  .landed .acute { animation: drop 520ms cubic-bezier(0.34, 1.56, 0.64, 1) both; }
  @keyframes drop { from { opacity: 0; transform: translateX(-30%) translateY(-0.6em) rotate(20deg); } to { opacity: 1; transform: translateX(-30%) rotate(38deg); } }
  .mark:hover .acute { transform: translateX(-30%) rotate(48deg) scaleY(1.12); }

  nav { margin-left: auto; display: flex; align-items: center; gap: clamp(12px, 2.4vw, 32px); }
  ul { list-style: none; padding: 0; display: flex; gap: clamp(14px, 2.4vw, 32px); }
  nav ul a {
    text-decoration: none; color: var(--mute); font-size: var(--step--1); font-weight: 500;
    position: relative; padding-block: 6px; transition: color var(--t-fast);
  }
  nav ul a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: var(--ink);
    transform: scaleX(0); transform-origin: right; transition: transform var(--t-med) var(--ease-out);
  }
  nav ul a:hover, nav ul a[aria-current='page'] { color: var(--ink); }
  nav ul a:hover::after, nav ul a[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }

  .contact svg { width: 15px; height: 15px; display: none; }
  @media (max-width: 640px) {
    .contact svg { display: block; }
    .bar { min-height: 64px; gap: 12px; }
    ul { gap: 14px; }
    .contact { padding: 0; width: 40px; height: 40px; justify-content: center; }
    .contact .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .contact svg { width: 17px; height: 17px; }
    .mark { font-size: 1.08rem; }
    ul { gap: 12px; }
  }
  @media (max-width: 370px) {
    .mark { font-size: 1rem; }
    nav ul a { font-size: 0.82rem; }
  }
</style>

<script>
  // Split-flap name: each letter flips through a few characters and lands, left to right.
  // Plays once per visit and on hover; skipped entirely for reduced-motion users.
  const mark = document.querySelector<HTMLElement>('.mark');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (mark && !reduce) {
    const logo = mark.querySelector<HTMLElement>('.logo')!;
    const chars = [...mark.querySelectorAll<HTMLElement>('.ch')];
    const pool = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
    let running = false;

    const roll = () => {
      if (running) return;
      running = true;
      // lock each flap to its final width so the name doesn't jitter while letters change
      chars.forEach((c) => { (c.parentElement as HTMLElement).style.width = `${c.parentElement!.getBoundingClientRect().width}px`; });
      logo.classList.remove('landed');
      logo.classList.add('rolling');
      let done = 0;
      chars.forEach((c, i) => {
        const final = c.dataset.final!;
        const flips = 4 + i + Math.floor(Math.random() * 3);
        let n = 0;
        const step = () => {
          n++;
          c.textContent = n >= flips ? final : pool[Math.floor(Math.random() * pool.length)];
          c.classList.remove('tick'); void c.offsetWidth; c.classList.add('tick');
          if (n < flips) setTimeout(step, 46);
          else if (++done === chars.length) {
            logo.classList.remove('rolling');
            logo.classList.add('landed');
            setTimeout(() => { chars.forEach((ch) => ((ch.parentElement as HTMLElement).style.width = '')); running = false; }, 600);
          }
        };
        setTimeout(step, i * 28);
      });
    };

    let seen = false;
    try { seen = sessionStorage.getItem('nameRolled') === '1'; sessionStorage.setItem('nameRolled', '1'); } catch {}
    if (!seen) requestAnimationFrame(() => setTimeout(roll, 180));
    mark.addEventListener('pointerenter', roll);
  }
</script>
