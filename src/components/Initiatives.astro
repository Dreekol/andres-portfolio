---
import { getCollection } from 'astro:content';
import InitiativeCard from './InitiativeCard.astro';
interface Props { parent: string }
const { parent } = Astro.props;
const items = (await getCollection('work')).filter((e) => e.data.parent === parent).sort((a, b) => a.data.order - b.data.order);
---
<section class="initiatives" aria-label="Initiatives">
  {items.map((e) => <InitiativeCard entry={e} />)}
</section>

<style>
  .initiatives { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 24px); margin-block: clamp(32px, 4vw, 48px) clamp(48px, 6vw, 80px); }
  @media (max-width: 720px) { .initiatives { grid-template-columns: 1fr; } }
</style>
